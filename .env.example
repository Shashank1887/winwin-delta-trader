# Delta Exchange India API Credentials
# Generate keys from: https://www.india.delta.exchange/app/api-management
# Note: Make sure to whitelist your current Public IP shown on the dashboard.
DELTA_API_KEY=your_delta_india_api_key_here
DELTA_API_SECRET=your_delta_india_api_secret_here

# Optional: Approximate USD to INR conversion rate used for contract sizing on USD-quoted perpetuals
USD_TO_INR_RATE=85.0

# Optional: GitHub Personal Access Token (Contents: Read & Write) for direct push via sync_github.py
GITHUB_TOKEN=your_github_pat_here
